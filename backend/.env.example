# Convo AI Backend Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# LLM Providers (Optional - Mock mode is used if no key is provided)

# Mistral AI
MISTRAL_API_KEY=
DEFAULT_MISTRAL_MODEL=mistral-small-latest

# Google Gemini
GEMINI_API_KEY=
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# OpenAI
OPENAI_API_KEY=
DEFAULT_OPENAI_MODEL=gpt-4o-mini

# Default active provider: 'mistral', 'gemini', 'openai', or 'mock'
ACTIVE_PROVIDER=mock
