# Convo AI Backend Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# LLM Providers (Optional - Mock mode is used if no key is provided)
# Google Gemini
GEMINI_API_KEY=
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# OpenAI (Optional)
OPENAI_API_KEY=
DEFAULT_OPENAI_MODEL=gpt-4o-mini

# Default active provider: 'gemini', 'openai', or 'mock'
ACTIVE_PROVIDER=mock

